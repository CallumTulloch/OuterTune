<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Adaptive icons expose only the central 72dp of a 108dp layer. Keeping the
      supplied artwork in that viewport prevents the coloured ring from being
      clipped by circular and rounded-square launcher masks.
    -->
    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/launcher_artwork" />
    </item>
</layer-list>
